@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(cxxmcp CONFIG REQUIRED)

set(_cxxmcp_gateway_cli_requires_config_io @CXXMCP_GATEWAY_BUILD_CONFIG_IO@)
set(_cxxmcp_gateway_runtime_targets
    "${CMAKE_CURRENT_LIST_DIR}/cxxmcp-gatewayRuntimeTargets.cmake")
if(EXISTS "${_cxxmcp_gateway_runtime_targets}")
    find_dependency(Threads REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cxxmcp-gatewayCoreTargets.cmake")
if(EXISTS "${_cxxmcp_gateway_runtime_targets}")
    include("${_cxxmcp_gateway_runtime_targets}")
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/cxxmcp-gatewayConfigIoTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/cxxmcp-gatewayConfigIoTargets.cmake")
endif()
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/cxxmcp-gatewayCliTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/cxxmcp-gatewayCliTargets.cmake")
endif()

set("cxxmcp-gateway_core_FOUND" FALSE)
if(TARGET cxxmcp-gateway::core)
    set("cxxmcp-gateway_core_FOUND" TRUE)
endif()
set("cxxmcp-gateway_runtime_FOUND" FALSE)
if(TARGET cxxmcp-gateway::runtime)
    set("cxxmcp-gateway_runtime_FOUND" TRUE)
endif()
set("cxxmcp-gateway_config_io_FOUND" FALSE)
if(TARGET cxxmcp-gateway::config_io)
    set("cxxmcp-gateway_config_io_FOUND" TRUE)
endif()
set("cxxmcp-gateway_cli_FOUND" FALSE)
if(TARGET cxxmcp-gateway::cli AND TARGET cxxmcp-gateway::runtime AND
   (NOT _cxxmcp_gateway_cli_requires_config_io OR
    TARGET cxxmcp-gateway::config_io))
    set("cxxmcp-gateway_cli_FOUND" TRUE)
endif()

foreach(_cxxmcp_gateway_component IN LISTS cxxmcp-gateway_FIND_COMPONENTS)
    set(_cxxmcp_gateway_found_var
        "cxxmcp-gateway_${_cxxmcp_gateway_component}_FOUND")
    if(NOT DEFINED ${_cxxmcp_gateway_found_var})
        set(${_cxxmcp_gateway_found_var} FALSE)
    endif()
    if(NOT ${${_cxxmcp_gateway_found_var}})
        if(cxxmcp-gateway_FIND_REQUIRED_${_cxxmcp_gateway_component})
            set(cxxmcp-gateway_FOUND FALSE)
            set(cxxmcp-gateway_NOT_FOUND_MESSAGE
                "cxxmcp-gateway component '${_cxxmcp_gateway_component}' is not available")
        endif()
    endif()
endforeach()

unset(_cxxmcp_gateway_runtime_targets)
unset(_cxxmcp_gateway_cli_requires_config_io)
