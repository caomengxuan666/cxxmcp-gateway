{
  "name": "fixture-gateway",
  "version": "1.0.0",
  "runtime": {
    "upstreamSessionMode": "persistent",
    "persistentSessionPoolSize": 2,
    "prewarmCapabilities": true
  },
  "upstreams": [
    {
      "id": "fixture",
      "transport": "stdio",
      "command": "fixture-server"
    }
  ]
}
